#!/bin/sh
set -eu

# GStreamer setup
export GST_PLUGIN_PATH="${SNAP}/usr/lib/x86_64-linux-gnu/gstreamer-1.0"
export GST_PLUGIN_SYSTEM_PATH="${SNAP}/usr/lib/x86_64-linux-gnu/gstreamer-1.0"
export GST_PLUGIN_SCANNER="${SNAP}/usr/lib/x86_64-linux-gnu/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner"
export GST_REGISTRY="${SNAP_USER_DATA}/.cache/gstreamer-1.0/registry.x86_64.bin"
mkdir -p "$(dirname "$GST_REGISTRY")"

# GIO modules
export GIO_EXTRA_MODULES="${SNAP}/usr/lib/x86_64-linux-gnu/gio/modules"
export GIO_MODULE_DIR="${SNAP}/usr/lib/x86_64-linux-gnu/gio/modules"

# Audio (ALSA/PulseAudio provided by PipeWire or PulseAudio on the host)
export ALSA_CONFIG_PATH="${SNAP}/usr/share/alsa/alsa.conf"

# Strict snaps use a snap-specific XDG_RUNTIME_DIR. Point libpulse to the
# host socket exposed by the audio-playback interface.
if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  if [ -S "${XDG_RUNTIME_DIR}/../pulse/native" ]; then
    export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/../pulse/native"
  elif [ -S "${XDG_RUNTIME_DIR}/pulse/native" ]; then
    export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"
  fi
fi

# Library paths (including libproxy backends)
export LD_LIBRARY_PATH="${SNAP}/usr/lib/x86_64-linux-gnu/libproxy:${SNAP}/usr/lib/x86_64-linux-gnu/pulseaudio:${SNAP}/usr/lib:${SNAP}/usr/lib/x86_64-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# GTK / Desktop
export GTK_USE_PORTAL=1
export GSETTINGS_SCHEMA_DIR="${SNAP}/usr/share/glib-2.0/schemas"
export XDG_DATA_DIRS="${SNAP}/usr/share:${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# Fix accessibility bus errors
export NO_AT_BRIDGE=1

exec "$@"
